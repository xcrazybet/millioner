{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "docs/**",
      "scripts/**",
      "admin/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "public/js/firestore.indexes.json"
  },
  "storage": {
    "rules": "public/js/storage.rules"
  }
}
